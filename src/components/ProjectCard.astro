---
import type { ProjectFallback } from '../data/projects';

interface Props {
	project: ProjectFallback;
	lang: 'zh' | 'en';
}

const { project, lang } = Astro.props;
const date = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
	year: 'numeric', month: 'short', day: 'numeric'
}).format(new Date(project.updatedAt));
---

<article class="project-card">
	<div class="flex items-start justify-between gap-6">
		<div>
			<p class="eyebrow">FEATURED OPEN SOURCE</p>
			<h2 class="mt-4 text-3xl font-semibold text-white">{project.name}</h2>
		</div>
		<span class="status-dot"><i></i>{lang === 'zh' ? '持续开发' : 'Active'}</span>
	</div>
	<p class="mt-5 max-w-2xl text-base leading-7 text-slate-300">{project.description[lang]}</p>
	<div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-slate-500">
		<span>★ {project.stars}</span><span>{project.language}</span><span>{lang === 'zh' ? '更新于' : 'Updated'} {date}</span>
	</div>
	<div class="mt-8 flex flex-wrap gap-3">
		<a class="button-primary" href={project.siteUrl}>{lang === 'zh' ? '查看项目文档' : 'Explore the project'}</a>
		<a class="button-secondary" href={project.repositoryUrl}>GitHub ↗</a>
	</div>
</article>
